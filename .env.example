# ==========================================
# Google Maps Data Extractor - SaaS Configuration
# ==========================================

# Database: Neon Postgres (Get this from https://neon.tech)
# Example: postgresql://user:password@ep-xyz-123456.us-east-2.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=

# Cloudinary Storage for PDFs (Get this from https://cloudinary.com)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Or single URL format:
# CLOUDINARY_URL=cloudinary://API_KEY:API_SECRET@CLOUD_NAME

# Application Settings
SECRET_KEY=super-secret-key-change-me
PORT=5000
